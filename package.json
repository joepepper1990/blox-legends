{
  "name": "blox-legends",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Roblox-style iPad learning game that trains 11+ (Kent Test / Shepway Test) skills.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node tools/build.mjs",
    "e2e": "node tools/build.mjs && node --test --test-concurrency=1 tests/e2e/app.e2e.js",
    "serve": "node tools/build.mjs && npx http-server _site -p 8080 -c-1",
    "e2e:live": "node --test --test-concurrency=1 tests/e2e/live.e2e.js"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=20"
  }
}
